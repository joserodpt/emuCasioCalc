# cmake -DOUTPUT=build_info.c -DSOURCE_DIR=... -P build_info.cmake
# Writes the build's date and time and git commit (Help > About), only when
# they change, so an up-to-date build doesn't relink.
string(TIMESTAMP when "%Y-%m-%d %H:%M")
set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE dirty
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(dirty)
    string(APPEND commit "+")  # built with uncommitted changes
  endif()
endif()
set(text "/* Generated by cmake/build_info.cmake at each build: do not edit. */
const char EMU_BUILD_TIME[] = \"${when}\";
const char EMU_BUILD_COMMIT[] = \"${commit}\";
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
  file(WRITE "${OUTPUT}" "${text}")
endif()
